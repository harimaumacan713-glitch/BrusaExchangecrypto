rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Market data: everyone can read, only admin can write
    match /market_data/{symbol} {
      allow read: if true;
      allow write: if false; 
    }

    // User-specific data
    match /wallets/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /exchange_wallets/{userId} {
      allow read, write: if isOwner(userId);
      // Allow access to sub-collections
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    match /external_transfers/{txId} {
      allow read: if isAuthenticated() && resource.data.receiverUid == request.auth.uid;
    }
    match /transfer_masuk/{txId} {
      allow read: if isAuthenticated() && resource.data.penerimaUid == request.auth.uid;
    }
    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
    }
  }
}
