{
  "entities": {
    "MarketData": {
      "title": "Market Data",
      "description": "Real-time price and statistics for an asset",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "price": { "type": "number" },
        "change": { "type": "number" },
        "mktcap": { "type": "string" },
        "volume": { "type": "string" },
        "isIdx": { "type": "boolean" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      },
      "required": ["symbol", "price", "lastUpdate"]
    }
  },
  "firestore": {
    "/market_data/{symbol}": {
      "schema": "MarketData",
      "description": "Real-time updates for each symbol"
    }
  }
}
